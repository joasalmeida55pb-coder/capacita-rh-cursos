# Copie para .env.local e preencha (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://imvglkxavgjyaqrkidys.supabase.co
# Chave publishable (sb_publishable_...) — ou use NEXT_PUBLIC_SUPABASE_ANON_KEY com a anon legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Acesso institucional ao Capacita Insights (Prefeitura). Obrigatório em produção.
# Sem estas variáveis, em desenvolvimento vale a conta demo gestor.demo / Capacita@2026.
INSIGHTS_USUARIO=
INSIGHTS_SENHA=
INSIGHTS_NOME=
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
CAPACITA_AUTH_SECRET=
